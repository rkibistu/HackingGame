  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'WPA2 secures WiFi by encrypting traffic between a device and router using
    a shared password. When a device connects, a four-way handshake exchanges cryptographic
    values to verify the password and establish a secure session key.

    

    WPA2
    Hashcrack Attack: Tools like hcxdumptool can capture this handshake by listening
    to traffic or forcing a reconnection. The capture is converted with hcxpcapngtool
    for use with hashcat, which attempts to crack the password via dictionary or
    brute-force attacks. This highlights the need for strong, complex WiFi passwords.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

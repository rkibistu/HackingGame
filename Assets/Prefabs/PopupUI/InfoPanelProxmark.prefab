  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Proxmark is an open-source hardware tool used for reading, writing,
    emulating, and analyzing RFID (Radio Frequency Identification) and NFC (Near
    Field Communication) tags. It is used by both security experts and amateur hackers
    in physical attacks including contactless keys or ID badges.\n\nThe device can
    interact with both low-frequency (125 kHz) and high-frequency (13.56 MHz) RFID
    systems, making it extremely versatile. With the right knowledge, a Proxmark
    can clone cards, sniff communication between a reader and a tag, or even emulate
    a tag entirely\u2014making it an essential tool in RFID security testing and
    hacking."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
